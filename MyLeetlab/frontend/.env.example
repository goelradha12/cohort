# ---------------------------------------------------------------------------
# Frontend environment template (Vite). Copy to `.env` and fill in if needed.
#
# VITE_API_URL sets the backend API base URL used by src/lib/axios.js.
# - If set, it is used as-is (recommended for production/staging).
# - If unset: development uses http://localhost:3000/api/v1, and any other mode
#   falls back to the same-origin path /api/v1 (requires a reverse proxy).
# ---------------------------------------------------------------------------

# Base URL for backend API calls (include the /api/v1 suffix)
# VITE_API_URL=https://api.your-domain.com/api/v1
