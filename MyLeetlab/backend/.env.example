# ---------------------------------------------------------------------------
# Backend environment template. Copy to `.env` and fill in real values.
# NEVER commit the real .env (it is git-ignored). Placeholders only here.
# ---------------------------------------------------------------------------

# Server
PORT=3000
# Use "production" when deployed behind HTTPS on separate domains. This enables
# secure, SameSite=None cookies and "trust proxy". Use "development" locally.
NODE_ENV=production
# Frontend origin allowed by CORS (also used to build email links).
# Production: https://leetcode.radhagoyal.in   Local: http://localhost:5173
BASE_URL=https://leetcode.radhagoyal.in

# Database (Prisma / PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# JWT auth
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
REFRESH_TOKEN_EXPIRY=7d

# Judge0-compatible code execution service
JUDGE0_URL=https://judge0-service.example.com
SULU_API_TOKEN=replace-with-judge0-auth-token

# Email delivery (Resend)
RESEND_API_KEY=
MAIL_FROM="LeetLab <noreply@radhagoyal.in>"

# Cloudinary image upload (code uses the first three; URL optional)
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Admin seed (used by createAdmin.js once item 12b is applied; see remediation-plan.md)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password
